#include <bits/stdc++.h>
using namespace std;

int main()
{
	// your code goes here
	int T;
	cin>>T;
	while(T--)
	{
	    int N;
	    cin>>N;
	    int arr[N];
	    for(int i=0;i<N;i++)
	    {
	        cin>>arr[i];
	    }
	    sort(arr, arr+N);
	    int max_freq=1,curr_freq=1;
	    
	    for(int i=1; i<N;i++)
	    {
	        if(arr[i]==arr[i-1])
	        {
	            curr_freq++;
	        }
	        else
	        {
	            max_freq = max(max_freq,curr_freq);
	            curr_freq=1;
	        }
	    }
	    max_freq = max(max_freq,curr_freq);
	    cout<<(max_freq+1)/2<<endl;
	}
	return 0;

}
