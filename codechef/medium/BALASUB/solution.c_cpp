#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    // Pattern 1: Adjacent equals
    for (int i = 0; i < n - 1; i++) {
        if (a[i] == a[i+1]) {
            cout << (i + 1) << " " << (i + 2) << "\n";
            return;
        }
    }

    // Pattern 2: Strict peak
    for (int i = 1; i < n - 1; i++) {
        if (a[i-1] < a[i] && a[i] > a[i+1]) {
            cout << i << " " << (i + 2) << "\n";
            return;
        }
    }

    // Pattern 3: Valley duplicates
    // Using a vector instead of a map guarantees O(N) time without high constant factors
    vector<int> seen(n + 1, -1);
    for (int i = 0; i < n; i++) {
        if (seen[a[i]] != -1) {
            cout << (seen[a[i]] + 1) << " " << (i + 1) << "\n";
            return;
        }
        seen[a[i]] = i;
    }

    // If no patterns are found
    cout << -1 << "\n";
}

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}