#include <bits/stdc++.h>
using namespace std;

int main()
{
	// your code goes here
	int T;
	cin>>T;
	while(T--)
	{
	    int N,K;
	    cin>>N>>K;
	    int arr[N];
	    for(int i=0;i<N;i++)
	    {
	        cin>>arr[i];
	    }
	    int W = N-K;
	    long max_sum=0;
	    for(int i=0;i<=K;i++)
	    {
	        long current_sum=0;
	        for(int j=i;j<i+W;j++)
	        {
	            current_sum+=arr[j];
	        }
	        if(current_sum>max_sum)
	        {
	        max_sum=current_sum;
	        }
	    }
	    cout<<max_sum<<endl;
	}

}
