#include <bits/stdc++.h>
using namespace std;

int main() 
{
	// your code goes here
	int T,rem;
	cin>>T;
	while(T--)
	{
	    int N,tot;
	    cin>>N;
	    if(N>=2)
	    {
	    rem=N%2;
	    tot= (N/2)*30 + rem*10;
	    }
	    else if(N==1)
	    {
	    tot = N*20;
	    }
	    cout<<tot<<endl;
	}
	return 0;

}
