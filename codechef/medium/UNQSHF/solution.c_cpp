#include <bits/stdc++.h>
using namespace std;

int main()
{
	// your code goes here
	int T;
	cin>>T;
	while(T--)
	{
	    int N;
	    cin>>N;
	    string A,B;
	    cin>>A;
	    cin>>B;
	    int a_count=0,b_count=0;
	    for(char c:A)
	    {
	       if(c=='a')
	       a_count++;
	    }
	    for(char c:B)
	    {
	       if(c=='b')
	       b_count++;
	    }
	    if(a_count==b_count)
	    cout<<"YES"<<endl;
	    else
	    cout<<"NO"<<endl;
	}
	return 0;

}
